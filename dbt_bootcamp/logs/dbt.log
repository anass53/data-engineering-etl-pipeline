  create  table "bootcamp"."dbt_schema"."mart_sales_performance__dbt_tmp"
  
  
    as
  
  (
    WITH int_sales AS (
    SELECT * FROM "bootcamp"."dbt_schema"."int_sales_by_region"
),

with_kpis AS (
    SELECT
        region,
        category,
        nb_orders,
        total_sales,
        total_profit,
        avg_discount,

        -- Marge bénéficiaire
        ROUND(
            CASE
                WHEN total_sales = 0 THEN 0
                ELSE total_profit / total_sales * 100
            END::numeric, 2
        ) AS profit_margin_pct,

        -- Part des ventes dans la région 
        ROUND(
            total_sales / SUM(total_sales) OVER (PARTITION BY region) * 100
            ::numeric, 2
        ) AS pct_of_region_sales,

        -- Rang par ventes dans la région
        RANK() OVER (
            PARTITION BY region
            ORDER BY total_sales DESC
        ) AS rank_in_region

    FROM int_sales
)

SELECT * FROM with_kpis
ORDER BY region, rank_in_region
  );
  
