[0m23:51:11.894475 [debug] [Thread-1 (]: On model.dbt_bootcamp.mart_breweries_performance: /* {"app": "dbt", "dbt_version": "1.11.10", "profile_name": "dbt_bootcamp", "target_name": "dev", "node_id": "model.dbt_bootcamp.mart_breweries_performance"} */

  
    

  create  table "bootcamp"."dbt_schema"."mart_breweries_performance__dbt_tmp"
  
  
    as
  
  (
    WITH int_brew AS (
    SELECT * FROM "bootcamp"."dbt_schema"."int_breweries_by_country"
),

with_kpis AS (
    SELECT
        country,
        brewery_type,
        nb_breweries,

        -- Part par pays
        ROUND(
            nb_breweries::numeric / SUM(nb_breweries) OVER (PARTITION BY country) * 100,
            2
        ) AS pct_of_country,

        -- Rang par pays
        RANK() OVER (
            PARTITION BY country
            ORDER BY nb_breweries DESC
        ) AS rank_in_country,

        -- Classification
        
    CASE
        WHEN nb_breweries < 5 THEN 'low'
        WHEN nb_breweries <= 20 THEN 'medium'
        ELSE 'High'
    END
 AS size_category

    FROM int_brew
)

SELECT * FROM with_kpis
ORDER BY country, rank_in_country
  );
  
