    Select * from "bootcamp"."public"."superstore_sales"
),

renamed as(
    select
        "Row ID"        AS ROw_id,
        "Order ID"      AS order_id,
        CAST("Order Date" AS DATE) AS order_date,
        CAST("Ship Date"  AS DATE) AS ship_date,
        "Ship Mode"     AS ship_mode,
